<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="g1_29dof">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import g1_29dof urdf file -->
    <xacro:include filename="$(find unitree_description)/urdf/unitree_g1.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="$(find unitree_description)/xacro/ros2_control/ros2_control.xacro" />


    <!-- <xacro:g1_29dof_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/> -->

</robot>
